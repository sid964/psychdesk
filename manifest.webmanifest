      "purpose": "any maskable"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "description": "Psychology study workspace with notes, textbooks, highlights, sticky notes, boards, mind maps, flashcards and Google account sync.",
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "params": {
      "title": "shareTitle",
      "text": "shareText",
      "url": "shareUrl"
    }
  }
